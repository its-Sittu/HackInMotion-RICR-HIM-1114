# Server Configuration
PORT=5000
NODE_ENV=development

# Client Configuration
FRONTEND_URL=http://localhost:5173

# Database Configuration
MONGODB_URI=your_mongodb_connection_string_here

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# EmailJS Provider (Free Email/OTP Delivery — 200 free emails/month)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_TO_EMAIL=

# SMS Provider — Fast2SMS (India)
FAST2SMS_API_KEY=

# SMS Provider — MSG91 (India SMS)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=

# SMS Provider — Twilio (optional)
# Leave blank to use dev-mode OTP logging (OTP printed to server console)
# Fill in credentials to activate real SMS delivery
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

